rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function userExists() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isFirmMember(firmId) {
      return userExists() && getUserData().firmId == firmId;
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidUser(data) {
      return hasOnlyAllowedFields(['uid', 'email', 'fullName', 'firmName', 'firmId', 'role', 'createdAt', 'title', 'phone', 'onboardingCompleted']) &&
             data.uid is string && data.uid == request.auth.uid &&
             data.email is string && data.email.size() < 100 &&
             data.fullName is string && data.fullName.size() < 100 &&
             data.firmName is string && data.firmName.size() < 100 &&
             data.firmId is string &&
             data.role in ['firm-admin', 'advisor', 'compliance-officer'] &&
             (!('title' in data) || (data.title is string && data.title.size() < 100)) &&
             (!('phone' in data) || (data.phone is string && data.phone.size() < 30)) &&
             (!('onboardingCompleted' in data) || data.onboardingCompleted is bool) &&
             data.createdAt is timestamp;
    }

    function isValidFirm(data) {
      return hasOnlyAllowedFields(['id', 'name', 'createdAt', 'subscriptionStatus', 'adminUid']) &&
             data.id is string &&
             data.name is string && data.name.size() < 100 &&
             data.subscriptionStatus in ['trial', 'active', 'cancelled'] &&
             data.adminUid is string && data.adminUid == request.auth.uid &&
             data.createdAt is timestamp;
    }

    function isValidScan(data) {
      return hasOnlyAllowedFields(['firmId', 'userId', 'title', 'type', 'contentUrl', 'risk_level', 'compliance_score', 'violations_detected', 'regulations_triggered', 'rule_references', 'explanation', 'suggested_compliant_revision', 'createdAt']) &&
             data.firmId is string &&
             data.userId is string && data.userId == request.auth.uid &&
             data.title is string && data.title.size() < 200 &&
             data.compliance_score is int && data.compliance_score >= 0 && data.compliance_score <= 100 &&
             data.createdAt is timestamp;
    }

    function isValidTrade(data) {
      return hasOnlyAllowedFields(['firmId', 'userId', 'employeeName', 'ticker', 'action', 'quantity', 'price', 'tradeDate', 'status', 'reviewNotes', 'createdAt']) &&
             data.firmId is string &&
             data.userId is string && data.userId == request.auth.uid &&
             data.ticker is string && data.ticker.size() < 10 &&
             data.action in ['BUY', 'SELL'] &&
             data.status in ['PENDING', 'APPROVED', 'FLAGGED', 'REJECTED'] &&
             data.createdAt is timestamp;
    }

    function isValidConflict(data) {
      return hasOnlyAllowedFields(['firmId', 'tradeId', 'type', 'severity', 'description', 'status', 'assignedTo', 'createdAt']) &&
             data.firmId is string &&
             data.tradeId is string &&
             data.type in ['FRONT-RUNNING', 'RESTRICTED-LIST', 'INSIDER-TRADING', 'OTHER'] &&
             data.severity in ['LOW', 'MEDIUM', 'HIGH', 'CRITICAL'] &&
             data.status in ['OPEN', 'INVESTIGATING', 'RESOLVED', 'DISMISSED'] &&
             data.createdAt is timestamp;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || (userExists() && resource != null && getUserData().firmId == resource.data.firmId));
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidUser(request.resource.data) && 
                    request.resource.data.role == resource.data.role &&
                    request.resource.data.firmId == resource.data.firmId;
    }

    // Firms collection
    match /firms/{firmId} {
      allow read: if isFirmMember(firmId);
      allow create: if isAuthenticated() && isValidFirm(request.resource.data);
      allow update: if isFirmMember(firmId) && userExists() && getUserData().role == 'firm-admin' && isValidFirm(request.resource.data);
    }

    // Scans collection
    match /scans/{scanId} {
      allow read: if isFirmMember(resource.data.firmId);
      allow create: if isFirmMember(request.resource.data.firmId) && isValidScan(request.resource.data);
      allow update, delete: if isFirmMember(resource.data.firmId) && userExists() && 
        (getUserData().role == 'firm-admin' || getUserData().role == 'compliance-officer');
    }

    // Trades collection
    match /trades/{tradeId} {
      allow read: if isFirmMember(resource.data.firmId);
      allow create: if isFirmMember(request.resource.data.firmId) && isValidTrade(request.resource.data);
      allow update, delete: if isFirmMember(resource.data.firmId) && userExists() && 
        (getUserData().role == 'firm-admin' || getUserData().role == 'compliance-officer');
    }

    // Conflicts collection
    match /conflicts/{conflictId} {
      allow read: if isFirmMember(resource.data.firmId);
      allow create: if isFirmMember(request.resource.data.firmId) && isValidConflict(request.resource.data);
      allow update, delete: if isFirmMember(resource.data.firmId) && userExists() && 
        (getUserData().role == 'firm-admin' || getUserData().role == 'compliance-officer');
    }

    // Scan Cache collection
    match /scanCache/{hashId} {
      allow read: if isAuthenticated();
      allow write: if false; // Enforced via Cloud Functions Admin SDK
    }
  }
}
