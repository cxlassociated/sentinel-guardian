rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }
    
    function isFirmMember(firmId) {
      return isAuthenticated() && getUserData().firmId == firmId;
    }

    // Firm isolated storage
    match /firms/{firmId}/{allPaths=**} {
      // Only members of the firm can read/write files in their firm's folder
      allow read, write: if isFirmMember(firmId);
    }
    
    // Public assets (if any)
    match /public/{allPaths=**} {
      allow read: if true;
    }
  }
}
